
-# =============================================================================
-# This component is a group of page buttons.
-# Clicking a page button unhides a page and hides all other pages.
-# 
-# A page is a subsection within a tab section.
-# Each tab section has unique pages.

-# =============================================================================
-# local parameter: YAML Object
-#
-#     pages: int
-#     Number of page buttons and pages to create
-#
-#     type: string
-#     An ID substring used to program JavaScript buttons
-#
-#     icon: string
-#     CSS classes from Font Awesome

%nav.pagination.is-centered.my-5(role="navigation" aria-label="pagination")
    %ul.pagination-list
        - for n in 0..(pages-1)
            %li
                %a.pagination-link(id="btn-#{type}-#{n}" aria-label="Goto page #{n+1}")
                    %span.icon
                        %i(class=icon)
                    %span= n+1
